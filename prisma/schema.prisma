generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Batch {
  id            String         @id @default(uuid())
  name          String         @unique
  users         User[]
  mockTests     MockTest[]
  notifications Notification[]
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  name              String
  role              String
  initialPassword   String?
  batchId           String?
  batch             Batch?             @relation(fields: [batchId], references: [id])
  attempts          Attempt[]
  notificationReads NotificationRead[]

  bookmarks Bookmark[]

  expoPushToken String?
}

model Exam {
  id          String     @id @default(uuid())
  name        String
  description String?
  mockTests   MockTest[]
}

model MockTest {
  id             String    @id @default(uuid())
  examId         String
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  title          String
  timerType      String
  totalDuration  Int
  overallCutoff  Float?
  sections       Section[]
  attempts       Attempt[]
  batches        Batch[]
}

model Section {
  id            String     @id @default(uuid())
  mockTestId    String
  mockTest      MockTest   @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  name          String
  duration      Int?
  cutoffMarks   Float?
  questions     Question[]
}

model Question {
  id              String    @id @default(uuid())
  sectionId       String
  section         Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text            String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctOption   String
  explanation     String?
  topic           String?
  positiveMarks   Float     @default(1.0)
  negativeMarks   Float     @default(-0.25)
  responses       Response[]

  bookmarks Bookmark[]
}

model Attempt {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTestId     String
  mockTest       MockTest   @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  startTime      DateTime   @default(now())
  endTime        DateTime?
  status         String     @default("IN_PROGRESS")
  totalScore     Float      @default(0)
  tabSwitchCount Int        @default(0)
  pauseCount     Int        @default(0)
  responses      Response[]

  deadline          DateTime?
  sectionDeadlines  Json?
  currentSectionIdx Int       @default(0)
  pausedAt          DateTime?
  pausedDurationMs  Int       @default(0)
}

model Response {
  id             String   @id @default(uuid())
  attemptId      String
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String?
  status         String
  timeSpent      Int      @default(0)
}

model Notification {
  id        String             @id @default(uuid())
  title     String
  message   String
  createdAt DateTime           @default(now())
  batchId   String?
  batch     Batch?             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  reads     NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())
  
  @@unique([userId, notificationId])
}
model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}
model Banner {
  id        String   @id @default(uuid())
  imageUrl  String
  linkUrl   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  title      String?
  subtitle   String?
  buttonText String?
}